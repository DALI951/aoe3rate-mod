; AoE3 Resource Rate Mod configuration
; Edit while the game is NOT running, or flip toggles via the F9 overlay panel.
[General]
Enabled=1
Hotkey=0x78
StartHidden=0

[Display]
FontName=
FontSize=14
Opacity=0.85
PosX=12
PosY=12
ShowHeader=1
ShowSlots567=0
DecimalPlaces=1
ShowPlusSign=1
ShowResourceNames=1
ShowZeroRates=1
ShowFood=1
ShowWood=1
ShowCoin=1
ShowExport=1
PositionMode=Default

[Rate]
SampleMs=500
Smoothing=med
Unit=min
UseGameTime=1
DiscontinuityRatio=3.0
ShowGains=1

[Debug]
; Enabled=0  -> EXPORT MODE (default): rates.log contains ONLY recurring
;               `t=%lu,food=%d,wood=%d,coin=%d,export=%d` lines (t in realtime
;               milliseconds, live integer values ~every 500ms).
;               The Python app (app\app.py, built on Dali's config/log_tailer/parser
;               core) tails this file to show the numbers in an always-on-top
;               window. NO other log lines. (d3d9mod.log = diagnostics only.)
; Enabled=1  -> FULL DIAGNOSTICS: verbose chain / device / draw / heartbeat
;               logging for debugging. NO export lines are written in this mode.
Enabled=0